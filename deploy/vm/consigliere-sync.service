# Fetches the data pack (deploy/vm/datapack-sync.sh). Started by consigliere-sync.timer and by install.sh.
[Unit]
Description=Consigliere data pack sync
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=consigliere
Group=consigliere
EnvironmentFile=/etc/consigliere/env
Environment=DEST=/var/lib/consigliere/pack HOME=/var/lib/consigliere
ExecStart=/opt/consigliere/current/deploy/vm/datapack-sync.sh
TimeoutStartSec=2min
StateDirectory=consigliere
StateDirectoryMode=0700
# In memory, and removed when the run ends: the deploy key lives here.
RuntimeDirectory=consigliere-sync
RuntimeDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
