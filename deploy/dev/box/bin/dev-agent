#!/usr/bin/python3 -I
"""The dev box's agent (docs/dev-box.md). The owner's bot asks it, over the tailnet, which repos have a Claude Code
session open, and starts new ones for the dashboard's Code page. dev-agent.service runs it as dev.

  GET  /sessions                          the open sessions
  POST /sessions {"repo": .., "mode": ..}  start one: mode "continue" (the repo's last conversation) or "new"

A session is a tmux session named <repo>-<n> running dev-session, so it ends when Claude does, and over SSH
`tmux attach -t <name>` shows the same terminal. Only tailnet machines tagged ALLOWED_TAG (the bot's) may ask, checked
with `tailscale whois`, and the agent never runs anything but tmux and dev-session.
"""
import itertools
import json
import os
import re
import subprocess
import sys
import threading
import time
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = 8790
ALLOWED_TAG = "tag:consigliere"
SRC = os.path.expanduser("~/src")
NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
MODES = ("continue", "new")
starting = threading.Lock()  # one start at a time, so two can't pick the same name
callers = {}  # client IP -> (checked until, allowed)


def run(*args, timeout=10):
    return subprocess.run(args, capture_output=True, text=True, timeout=timeout)


def repos():
    return {n for n in os.listdir(SRC) if NAME.match(n) and os.path.isdir(os.path.join(SRC, n, ".git"))}


def sessions():
    out = run("tmux", "list-sessions", "-F", "#{session_name}\t#{session_created}")
    if out.returncode != 0:  # no tmux server, so nothing open
        return []
    known, found = repos(), []
    for line in out.stdout.splitlines():
        name, _, created = line.partition("\t")
        repo, _, n = name.rpartition("-")
        if repo in known and n.isdigit():
            started = datetime.fromtimestamp(int(created), timezone.utc).isoformat().replace("+00:00", "Z")
            found.append({"name": name, "repo": repo, "startedAt": started})
    return sorted(found, key=lambda s: s["startedAt"])


def start(repo, mode):
    """Returns (HTTP status, reply)."""
    with starting:
        if repo not in repos():
            return 404, {"error": f"no repo {repo} in ~/src"}
        open_now = [s["name"] for s in sessions() if s["repo"] == repo]
        if mode == "continue" and open_now:
            # A second `claude --continue` would fork the same conversation.
            return 409, {"error": f"{repo} already has a session open ({open_now[-1]}): open it in the Claude app"}
        name = next(f"{repo}-{i}" for i in itertools.count(1) if f"{repo}-{i}" not in open_now)
        out = run("tmux", "new-session", "-d", "-s", name, "-x", "200", "-y", "50", "-c", os.path.join(SRC, repo),
                  "/usr/local/bin/dev-session", repo, mode, name)
        if out.returncode != 0:
            return 500, {"error": f"tmux: {out.stderr.strip()}"}
    time.sleep(3)  # Claude Code fails fast (bad flags, signed out); the session ends with it
    if run("tmux", "has-session", "-t", f"={name}").returncode != 0:
        return 500, {"error": f"Claude Code exited right away. SSH in and run claude in ~/src/{repo} to see why."}
    return 201, {"name": name, "repo": repo}


def allowed(ip):
    checked = callers.get(ip)
    if checked and checked[0] > time.monotonic():
        return checked[1]
    ok = False
    out = run("tailscale", "whois", "--json", ip)
    if out.returncode == 0:
        try:
            ok = ALLOWED_TAG in ((json.loads(out.stdout).get("Node") or {}).get("Tags") or [])
        except ValueError:
            pass
    callers[ip] = (time.monotonic() + 60, ok)
    return ok


class Handler(BaseHTTPRequestHandler):
    server_version = "dev-agent"

    def do_GET(self):
        if not self.caller_allowed():
            return
        if self.path != "/sessions":
            return self.reply(404, {"error": "not found"})
        self.reply(200, {"sessions": sessions()})

    def do_POST(self):
        if not self.caller_allowed():
            return
        if self.path != "/sessions":
            return self.reply(404, {"error": "not found"})
        try:
            length = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(length)) if 0 < length <= 4096 else {}
            repo, mode = body.get("repo"), body.get("mode")
        except (ValueError, AttributeError):
            repo = mode = None
        if not isinstance(repo, str) or not NAME.match(repo) or mode not in MODES:
            return self.reply(400, {"error": 'send {"repo": <name>, "mode": "continue" or "new"}'})
        self.reply(*start(repo, mode))

    def caller_allowed(self):
        if allowed(self.client_address[0]):
            return True
        self.reply(403, {"error": f"only {ALLOWED_TAG} machines may ask"})
        return False

    def reply(self, status, body):
        data = json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)


def main():
    # Listen on the tailnet address only; until Tailscale has one, exit and let systemd retry.
    ip = run("tailscale", "ip", "-4").stdout.split()
    if not ip:
        sys.exit("not on the tailnet yet")
    ThreadingHTTPServer((ip[0], PORT), Handler).serve_forever()


if __name__ == "__main__":
    main()
