#!/usr/bin/python3 -I
"""The dev box's agent (docs/dev-box.md). The owner's bot asks it, over the tailnet, which repos have a Claude Code
session open, starts and stops them for the dashboard's Code page, and asks whether the box is idle enough to sleep.
dev-agent.service runs it as dev.

  GET    /sessions                          the open sessions
  POST   /sessions {"repo": .., "mode": ..}  start one: mode "continue" (the repo's last conversation) or "new"
  DELETE /sessions/<name>                   stop one (its conversation stays on disk for the next Continue)
  GET    /repos                             each repo's branch, uncommitted changes, ahead/behind, last commit, open PRs
  GET    /activity                          since when nothing has happened: no session output, no one logged in
  GET    /plan/<repo>?path=docs/roadmap.md  the repo's plan file on its default branch, and where open branches differ

A session is a tmux session named <repo>-<n> running dev-session, so it ends when Claude does, and over SSH
`tmux attach -t <name>` shows the same terminal. Only tailnet machines tagged ALLOWED_TAG (the bot's) may ask, checked
with `tailscale whois`. The agent runs tmux and dev-session, and git and gh only to read.
"""
import itertools
import json
import os
from concurrent.futures import ThreadPoolExecutor
import re
import subprocess
import sys
import threading
import time
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs

PORT = 8790
ALLOWED_TAG = "tag:consigliere"
SRC = os.path.expanduser("~/src")
NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
MODES = ("continue", "new")
starting = threading.Lock()  # one start at a time, so two can't pick the same name
callers = {}  # client IP -> (checked until, allowed)
PR_TTL = 300  # open PRs come from GitHub, so they're kept for 5 minutes
prs_cache = {}  # repo -> (fetched at, PRs)
last_activity = time.time()  # the agent starting counts: the box just booted


def run(*args, timeout=10, cwd=None):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout, cwd=cwd)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(args, 124, "", "timed out")


def repos():
    return {n for n in os.listdir(SRC) if NAME.match(n) and os.path.isdir(os.path.join(SRC, n, ".git"))}


def sessions():
    out = run("tmux", "list-sessions", "-F", "#{session_name}\t#{session_created}")
    if out.returncode != 0:  # no tmux server, so nothing open
        return []
    known, found = repos(), []
    for line in out.stdout.splitlines():
        name, _, created = line.partition("\t")
        repo, _, n = name.rpartition("-")
        if repo in known and n.isdigit():
            started = datetime.fromtimestamp(int(created), timezone.utc).isoformat().replace("+00:00", "Z")
            found.append({"name": name, "repo": repo, "startedAt": started})
    return sorted(found, key=lambda s: s["startedAt"])


def start(repo, mode):
    """Returns (HTTP status, reply)."""
    with starting:
        if repo not in repos():
            return 404, {"error": f"no repo {repo} in ~/src"}
        open_now = [s["name"] for s in sessions() if s["repo"] == repo]
        if mode == "continue" and open_now:
            # A second `claude --continue` would fork the same conversation.
            return 409, {"error": f"{repo} already has a session open ({open_now[-1]}): open it in the Claude app"}
        name = next(f"{repo}-{i}" for i in itertools.count(1) if f"{repo}-{i}" not in open_now)
        out = run("tmux", "new-session", "-d", "-s", name, "-x", "200", "-y", "50", "-c", os.path.join(SRC, repo),
                  "/usr/local/bin/dev-session", repo, mode, name)
        if out.returncode != 0:
            return 500, {"error": f"tmux: {out.stderr.strip()}"}
    time.sleep(3)  # Claude Code fails fast (bad flags, signed out); the session ends with it
    if run("tmux", "has-session", "-t", f"={name}").returncode != 0:
        return 500, {"error": f"Claude Code exited right away. SSH in and run claude in ~/src/{repo} to see why."}
    return 201, {"name": name, "repo": repo}


def stop(name):
    """Returns (HTTP status, reply)."""
    if name not in {s["name"] for s in sessions()}:
        return 404, {"error": f"no session {name}"}
    out = run("tmux", "kill-session", "-t", f"={name}")
    if out.returncode != 0:
        return 500, {"error": f"tmux: {out.stderr.strip()}"}
    return 200, {"stopped": name}


def git(repo, *args):
    out = run("git", "-C", os.path.join(SRC, repo), *args)
    return out.stdout.strip() if out.returncode == 0 else ""


def open_prs(repo):
    cached = prs_cache.get(repo)
    if cached and cached[0] > time.monotonic() - PR_TTL:
        return cached[1]
    out = run("gh", "pr", "list", "--state", "open", "--json", "number,title,url,headRefName,isDraft", "--limit", "20",
              cwd=os.path.join(SRC, repo), timeout=20)
    prs = []
    if out.returncode == 0:
        try:
            prs = [{"number": p["number"], "title": p["title"], "url": p["url"], "branch": p["headRefName"],
                    "draft": p.get("isDraft", False)} for p in json.loads(out.stdout)]
        except (ValueError, KeyError, TypeError):
            prs = None
    else:
        prs = None  # unknown, not none: GitHub didn't answer
    prs_cache[repo] = (time.monotonic(), prs)
    return prs


def repo_state(repo):
    branch = git(repo, "branch", "--show-current") or "(detached)"
    changes = len([line for line in git(repo, "status", "--porcelain").splitlines() if line.strip()])
    ahead = behind = None
    counts = git(repo, "rev-list", "--left-right", "--count", "@{upstream}...HEAD").split()
    if len(counts) == 2:
        behind, ahead = int(counts[0]), int(counts[1])
    subject, _, at = git(repo, "log", "-1", "--format=%s%x00%cI").partition("\0")
    return {"name": repo, "branch": branch, "changes": changes, "ahead": ahead, "behind": behind,
            "lastCommit": {"subject": subject, "at": at} if subject else None, "prs": open_prs(repo)}


def repo_states():
    with ThreadPoolExecutor(max_workers=6) as pool:
        return sorted(pool.map(repo_state, repos()), key=lambda r: r["name"].lower())


def activity():
    """The box is busy while a session prints something or someone is logged in; idleSince is when that last was."""
    global last_activity
    now = time.time()
    out = run("tmux", "list-sessions", "-F", "#{session_activity}")
    if out.returncode == 0:
        for line in out.stdout.split():
            if line.isdigit():
                last_activity = max(last_activity, int(line))
    logins = len([line for line in run("who").stdout.splitlines() if line.strip()])
    if logins:
        last_activity = now
    since = datetime.fromtimestamp(last_activity, timezone.utc).isoformat().replace("+00:00", "Z")
    return {"idleSince": since, "sessions": len(sessions()), "logins": logins}


PLAN_PATH = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._/-]*\.md$")
PLAN_MAX = 256 * 1024


def show(repo, ref, path):
    out = run("git", "-C", os.path.join(SRC, repo), "show", f"{ref}:{path}")
    return out.stdout[:PLAN_MAX] if out.returncode == 0 else None


def plan(repo, path):
    """Returns (HTTP status, reply): the plan file as of the last fetch, on the default branch and on open branches
    where it's different (branches with an open PR, or recent unmerged ones when GitHub doesn't answer)."""
    if repo not in repos():
        return 404, {"error": f"no repo {repo} in ~/src"}
    if not PLAN_PATH.match(path) or ".." in path.split("/"):
        return 400, {"error": "the plan must be a .md file inside the repo"}
    default = git(repo, "symbolic-ref", "--short", "refs/remotes/origin/HEAD") or "origin/main"
    base = default.removeprefix("origin/")
    text = show(repo, default, path)
    fetched = os.path.join(SRC, repo, ".git", "FETCH_HEAD")
    as_of = datetime.fromtimestamp(os.path.getmtime(fetched), timezone.utc).isoformat().replace("+00:00", "Z") if os.path.exists(fetched) else None
    reply = {"path": path, "branch": base, "text": text, "asOf": as_of, "branches": []}
    if text is None:
        return 200, reply
    prs = open_prs(repo)
    if prs is not None:
        candidates = [p["branch"] for p in prs]
    else:
        unmerged = git(repo, "branch", "-r", "--no-merged", default, "--sort=-committerdate", "--format=%(refname:short)")
        candidates = [b.removeprefix("origin/") for b in unmerged.splitlines() if b.startswith("origin/") and b != "origin/HEAD"]
    for branch in list(dict.fromkeys(candidates))[:10]:
        other = show(repo, "origin/" + branch, path)
        if other is not None and other != text:
            reply["branches"].append({"branch": branch, "text": other})
    return 200, reply


def allowed(ip):
    checked = callers.get(ip)
    if checked and checked[0] > time.monotonic():
        return checked[1]
    ok = False
    out = run("tailscale", "whois", "--json", ip)
    if out.returncode == 0:
        try:
            ok = ALLOWED_TAG in ((json.loads(out.stdout).get("Node") or {}).get("Tags") or [])
        except ValueError:
            pass
    callers[ip] = (time.monotonic() + 60, ok)
    return ok


class Handler(BaseHTTPRequestHandler):
    server_version = "dev-agent"

    def do_GET(self):
        if not self.caller_allowed():
            return
        if self.path == "/sessions":
            return self.reply(200, {"sessions": sessions()})
        if self.path == "/repos":
            return self.reply(200, {"repos": repo_states()})
        if self.path == "/activity":
            return self.reply(200, activity())
        route, _, query = self.path.partition("?")
        if route.startswith("/plan/"):
            repo = route.removeprefix("/plan/")
            path = parse_qs(query).get("path", ["docs/roadmap.md"])[0]
            if not NAME.match(repo):
                return self.reply(404, {"error": "not found"})
            return self.reply(*plan(repo, path))
        self.reply(404, {"error": "not found"})

    def do_DELETE(self):
        if not self.caller_allowed():
            return
        name = self.path.removeprefix("/sessions/")
        if name == self.path or not NAME.match(name):
            return self.reply(404, {"error": "not found"})
        self.reply(*stop(name))

    def do_POST(self):
        if not self.caller_allowed():
            return
        if self.path != "/sessions":
            return self.reply(404, {"error": "not found"})
        try:
            length = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(length)) if 0 < length <= 4096 else {}
            repo, mode = body.get("repo"), body.get("mode")
        except (ValueError, AttributeError):
            repo = mode = None
        if not isinstance(repo, str) or not NAME.match(repo) or mode not in MODES:
            return self.reply(400, {"error": 'send {"repo": <name>, "mode": "continue" or "new"}'})
        self.reply(*start(repo, mode))

    def caller_allowed(self):
        if allowed(self.client_address[0]):
            return True
        self.reply(403, {"error": f"only {ALLOWED_TAG} machines may ask"})
        return False

    def reply(self, status, body):
        data = json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)


def main():
    # Listen on the tailnet address only; until Tailscale has one, exit and let systemd retry.
    ip = run("tailscale", "ip", "-4").stdout.split()
    if not ip:
        sys.exit("not on the tailnet yet")
    ThreadingHTTPServer((ip[0], PORT), Handler).serve_forever()


if __name__ == "__main__":
    main()
