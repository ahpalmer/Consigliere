#!/bin/sh
# A git credential helper for https://github.com (set in the dev user's git config): answers with the GitHub token
# from the dev box's Key Vault, read fresh on every fetch and push and never stored. `store` and `erase` do nothing.
set -eu
[ "${1:-}" = get ] || exit 0
cat >/dev/null # git sends the request on stdin; every GitHub request gets the same token
token=$(dev-kv-get github-token) || exit 0 # no token yet: git reports the failure
printf 'username=x-access-token\npassword=%s\n' "$token"
