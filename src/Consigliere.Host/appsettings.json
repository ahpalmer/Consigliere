{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "DataPack": {
    "Path": "../../samples/data-pack"
  },
  "Llm": {
    "Models": {
      "chat": "claude-opus-5-5",
      "draft": "claude-opus-5-5",
      "score": "claude-haiku-5-5"
    },
    "MaxHistoryTurns": 20
  },
  "Telegram": {
    "AllowedChatIds": []
  },
  "Radar": {
    "ScanCron": "0 * * * *",
    "DigestCron": "0 8 * * *",
    "DigestMaxItems": 25,
    "DatabasePath": "db/consigliere.db"
  },
  "Scheduler": {
    "TimeZone": "America/New_York"
  }
}
