{
  "LogLevel": "info",
  "DataPack": {
    "Path": "samples/data-pack"
  },
  "Llm": {
    "Models": {
      "chat": "claude-opus-5-5",
      "draft": "claude-opus-5-5",
      "score": "claude-haiku-5-5",
      "extract": "claude-haiku-5-5"
    },
    "MaxHistoryTurns": 20
  },
  "Telegram": {
    "AllowedChatIds": []
  },
  "Radar": {
    "ScanCron": "0 * * * *",
    "ScoreCron": "*/15 * * * *",
    "DigestCron": "0 8 * * *",
    "TuningCron": "0 18 * * 0",
    "DigestMaxItems": 25,
    "DigestMinScore": 50,
    "AlertMinScore": 75,
    "ScoreBatchSize": 200,
    "ScoreConcurrency": 8,
    "DatabasePath": "db/consigliere.db"
  },
  "Pipeline": {
    "ActiveSoftCap": 10,
    "FollowUpDays": 7,
    "GhostDays": 30,
    "SuggestHighScore": 80,
    "SuggestMediumScore": 60,
    "SuggestMaxHigh": 10,
    "SuggestMaxMedium": 20,
    "SuggestPerCompany": 2,
    "AutoPrepareKits": 5,
    "PrepareCron": "30 7 * * *",
    "SummaryCron": "0 9 1 * *"
  },
  "Scheduler": {
    "TimeZone": "America/New_York"
  },
  "Mail": {
    "Query": "newer_than:14d -in:trash",
    "MaxMessagesPerScan": 100,
    "IncludeSpam": true,
    "BackfillQuery": "newer_than:180d -in:trash",
    "BackfillMax": 500,
    "UpdateSenderDomains": [
      "greenhouse.io",
      "greenhouse-mail.io",
      "lever.co",
      "ashbyhq.com",
      "myworkday.com",
      "workday.com",
      "icims.com",
      "smartrecruiters.com",
      "jobvite.com",
      "taleo.net",
      "successfactors.com",
      "workablemail.com",
      "workable.com",
      "bamboohr.com",
      "rippling.com",
      "calendly.com",
      "goodtime.io",
      "gem.com",
      "paradox.ai",
      "hirevue.com",
      "codesignal.com",
      "hackerrank.com",
      "karat.com",
      "coderpad.io",
      "eightfold.ai"
    ],
    "BlockedSenders": [
      "accounts.google.com",
      "accountprotection.microsoft.com",
      "account.microsoft.com",
      "security-noreply",
      "security@",
      "account-security",
      "noreply@github.com",
      "notifications@github.com",
      "payments-noreply",
      "googleplay-noreply"
    ],
    "AllowedSenderDomains": [
      "linkedin.com",
      "indeed.com",
      "glassdoor.com",
      "wellfound.com",
      "ziprecruiter.com",
      "dice.com",
      "builtin.com",
      "levels.fyi"
    ]
  },
  "Web": {
    "Listen": "127.0.0.1:8080"
  },
  "Backup": {
    "Cron": "30 3 * * *"
  }
}
